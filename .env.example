# Copy this file to .env before running docker compose up -d --build.
# PostgreSQL created by Docker. Keep these credentials and DATABASE_URL in sync.
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms
POSTGRES_DB=hrms

# Inside Docker, the database hostname is postgres (not localhost).
# For an external database, replace this with its actual address and credentials.
DATABASE_URL=postgresql+asyncpg://hrms:hrms@postgres:5432/hrms
# If running Python directly outside Docker, instead use localhost:5433.

# Redis is unused on Day 1; wired now for later payroll/background jobs.
# Docker Compose publishes Redis on host port 6380 (container stays 6379)
# in case a local Redis already owns 6379.
REDIS_URL=redis://localhost:6380/0

# Bind address for local uvicorn (Docker overrides this).
APP_HOST=0.0.0.0
APP_PORT=8000

# JWT for owner login after self-serve trial registration.
GOOGLE_CLIENT_ID=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@nexgenfuelworks.com
BREVO_SENDER_NAME=HRMS
# Set true when serving the portal over HTTPS.
GOOGLE_COOKIE_SECURE=false

JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_MINUTES=30
# Platform owner console (not a tenant). Seeded on startup if missing.
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
PLATFORM_ADMIN_NAME=Platform Owner

# Company subdomains and verified custom domains
HRMS_BASE_DOMAIN=hrms.techtutor.co.ke
HRMS_DOMAIN_TARGET=hrms.techtutor.co.ke
# Add your server's IP or hostname, separated by a comma, when testing remotely.
HRMS_CENTRAL_HOSTS=localhost,127.0.0.1,::1,test,backend
# Public deployment additionally needs DOMAIN_TLS_SECRET, TLS_EMAIL and strong
# JWT_SECRET / PLATFORM_ADMIN_PASSWORD. See COMPANY_DOMAINS.md.
DOMAIN_TLS_SECRET=
TLS_EMAIL=
